# =================================================================
#  Re:Seat 프로젝트 — 로컬 / Docker 인프라 환경변수 템플릿
#
#  사용법:
#    1. cp .env.example .env
#    2. .env 파일을 열고 <your-*> 자리를 실제 값으로 채우세요.
# =================================================================

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=<your-mysql-root-password>
MYSQL_DATABASE=<your-mysql-database>

# Spring Boot Database Configuration
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>  # MYSQL_ROOT_PASSWORD와 동일 값
SPRING_DATASOURCE_URL=<your-mysql-database-url>

# Redis Configuration
REDIS_PASSWORD=<your-redis-password>

# JWT Security Configuration
JWT_SECRET=<your-jwt-secret>

# Kakao Social Login Configuration
KAKAO_CLIENT_ID=<your-kakao-client-id>
KAKAO_CLIENT_SECRET=<your-kakao-client-secret>

# PortOne Identity Verification Configuration
PORTONE_API_KEY=<your-portone-rest-api-key>
PORTONE_API_SECRET=<your-portone-rest-api-secret>
VITE_PORTONE_USER_CODE=<your-portone-user-code>

# Kakao Map (Frontend)
NEXT_PUBLIC_KAKAO_MAP_API_KEY=<your-kakao-map-javascript-key>

# Frontend API Endpoints
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_BACKEND_BASE_URL=http://localhost:8080

# Frontend 로컬 개발 시 백엔드 미기동 상태에서도 화면 확인 가능하도록 Mock 데이터로 대체할지 여부
VITE_USE_MOCK_FALLBACK=true

# Toss Payments 테스트 클라이언트 키
VITE_TOSS_CLIENT_KEY=<team-toss-test-client-key>